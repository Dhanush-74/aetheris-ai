# Server Port
PORT=5000
NODE_ENV=development

# Client Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/aetheris_ai
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/aetheris?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_secure_random_jwt_secret_key_here

# Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Conversation history context window (number of previous messages passed to AI)
MAX_HISTORY_MESSAGES=20
